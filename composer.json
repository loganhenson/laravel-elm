{
  "name": "loganhenson/laravel-elm",
  "description": "The Elm Laravel Platform",
  "license": "MIT",
  "keywords": [
    "laravel",
    "elm",
    "vite"
  ],
  "homepage": "https://github.com/loganhenson/laravel-elm",
  "support": {
    "issues": "https://github.com/loganhenson/laravel-elm/issues",
    "source": "https://github.com/loganhenson/laravel-elm"
  },
  "authors": [
    {
      "name": "Logan Henson",
      "email": "logan@loganhenson.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "laravel/framework": "^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "LoganHenson\\Elm\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "LoganHenson\\Elm\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "aliases": {
        "Elm": "LoganHenson\\Elm\\Elm"
      },
      "providers": [
        "LoganHenson\\Elm\\ElmServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
